# zimasa-zcare-service environment. Copy to .env (git-ignored) and replace every change-me.
# Never commit real values.

# --- Database: the service connects as zc_app, which owns nothing and cannot bypass RLS ---
DB_URL=jdbc:postgresql://localhost:5433/zimasa_zcare_service
DB_USERNAME=zc_app
DB_PASSWORD=change-me

# --- Migrations: run at startup as the schema owner, never as zc_app ---
DB_MIGRATION_USERNAME=zimasa_zcare_service_owner
DB_MIGRATION_PASSWORD=change-me
# Set to false where migrations run as a separate deployment step.
DB_MIGRATE_ON_STARTUP=true

# --- Local database setup script and compose file only ---
DB_ADMIN_USERNAME=postgres
DB_ADMIN_PASSWORD=change-me

# --- Sign-in: Keycloak (realm, clients and claims are still being agreed: OD-11) ---
KEYCLOAK_ISSUER_URI=
KEYCLOAK_JWK_SET_URI=
KEYCLOAK_AUDIENCE=zimasa-zcare-service
ZCARE_TENANT_CLAIM=tenant
ZCARE_ORGANISATION_CLAIM=org

# --- Local runs only: tokens signed with this shared secret (scripts/dev-token.*), at least
# --- 32 bytes. Leave empty wherever Keycloak is configured; never set it in a deployed environment.
ZCARE_JWT_HMAC_SECRET=

# --- Spring profile: local for development ---
SPRING_PROFILES_ACTIVE=local

# --- Web server (web-server/): holds browser sessions; see web-server/README.md ---
ZCARE_API_BASE_URL=http://localhost:8080
# keycloak (the default) is a placeholder that refuses to start; local is for development only.
ZCARE_WEB_SIGN_IN=local
# Local sign-in password shared by the local users, at least 12 characters.
ZCARE_WEB_LOCAL_PASSWORD=change-me-locally
